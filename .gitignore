# 依赖与构建产物（CI 会重新生成，不入库）
node_modules/
app/out/
app/dist/
app/release/

# 自带引擎产物目录：由 CI 的 npm run build:engine 生成，不入库
# （本地占位 .gitkeep 也一并忽略；electron-builder 打包前由 build:engine 重建该目录）
app/engine-dist/win/*
app/engine-dist/mac/*
# 本地重新打包引擎前的临时备份目录（win-prev-<时间戳>，单个数百 MB）
app/engine-dist/win-prev-*/
!app/engine-dist/README.md

# Python 引擎构建中间产物
ai-engine/build/
ai-engine/dist/
ai-engine/.venv-engine/
__pycache__/
*.py[cod]

# ONNX 权重体积大，默认不入库（用户/CI 按 models/README.md 放入）
ai-engine/models/*.onnx

# 数据库/缓存/日志
*.sqlite
*.db
*.log
logs/

# 离线核查脚本（tier-report / rescan-impact 等）的临时输出，只用来当场看数，不入库
app/scripts/_*.txt
# 体检/试点脚本的一次性输出（只读诊断产物，不进版本库）
scripts/_*.txt
app/scripts/_*.json
app/scripts/_*.cjs
app/_*.cjs
# 引擎侧的一次性取证/校准脚本与产物（下划线开头 + 缓存/截图目录），只用于当场核对
ai-engine/_*.py
ai-engine/_*.cjs
ai-engine/_*.jsonl
ai-engine/_*.json
ai-engine/_*.txt
ai-engine/_shot/
ai-engine/_cache2000/
# 同属一次性取证探针（早年没加下划线，一样只用于当场核对，不进仓库也不进安装包）
ai-engine/cmp_replay.py
ai-engine/crop-eyes.py
ai-engine/probe-eyes.py
ai-engine/probe_person_fp.py
ai-engine/replay_lib.py
ai-engine/scan_evidence.py
# 根目录临时 diff/脚本
_tmp_*.diff
_tmp_*.ps1
# 提示词 A/B 跑分台的全部输出（原始判定 jsonl、眼睛真值表、联络表大图），体积大且纯诊断，禁止入库
app/scripts/out/

# 系统/编辑器杂项
.DS_Store
Thumbs.db
.idea/
.vscode/
*.local

# Superpowers SDD 工作区（计划执行的账本/评审临时文件，不入库）
.superpowers/

# 模型由 CI 的 fetch-models 自动下载，不进仓库
ai-engine/models/*.tflite
# 本地归档（校准数据/客户图），含隐私，禁止上传
归档/
